ze:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--violet);margin-bottom:10px}\n  h2{font-size:clamp(24px,3.4vw,34px);font-weight:800;margin-bottom:14px}\n  .section-lead{max-width:680px;color:var(--ink-soft);margin-bottom:30px}\n\n  /* 跳转链接条 */\n  .jump{display:flex;flex-wrap:wrap;gap:8px;padding:18px 0 0;border-top:1px dashed var(--line);margin-top:16px}\n  .jump a{font-size:13px;padding:5px 12px;border:1px solid var(--line);color:var(--ink-soft);background:var(--panel)}\n  .jump a:hover{border-color:var(--violet);color:var(--violet);background:var(--violet-soft)}\n\n  /* 使用说明 */\n  .steps{counter-reset:step;display:grid;gap:0}\n  .step{display:grid;grid-template-columns:64px 1fr;gap:20px;padding:22px 0;border-bottom:1px dashed var(--line)}\n  .step:first-child{border-top:1px dashed var(--line)}\n  .step::before{counter-increment:step;content:counter(step,decimal-leading-zero);font-size:30px;font-weight:800;color:var(--violet);line-height:1}\n  .step h3{font-size:18px;margin-bottom:6px}\n  .step p{color:var(--ink-soft);font-size:15px}\n\n  /* 方案：单列大卡依次堆叠 */\n  .plans{display:grid;gap:20px}\n  .plan{background:var(--panel);border:1px dashed var(--line);padding:26px 26px 28px;position:relative}\n  .plan.top{border:1px dashed var(--violet);background:#fbf8ff}\n  .plan-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:14px;padding-bottom:16px;border-bottom:1px dashed var(--line);margin-bottom:18px}\n  .plan-head h3{font-size:22px}\n  .badge{font-size:11px;letter-spacing:.14em;text-transform:uppercase;background:var(--violet);color:#fff;padding:3px 9px}\n  .price{margin-left:auto;text-align:right}\n  .price b{font-size:28px;font-weight:800}\n  .price span{display:block;font-size:13px;color:var(--mute)}\n  .plan ul{margin:0;padding:0;list-style:none;display:grid;gap:10px}\n  .plan li{font-size:15px;color:var(--ink-soft);padding-left:20px;position:relative}\n  .plan li::before{content:\"\";position:absolute;left:0;top:9px;width:9px;height:1px;background:var(--violet)}\n  .plan-note{margin-top:18px;font-size:13px;color:var(--mute);border-top:1px dashed var(--line);padding-top:12px}\n\n  /* 客户端 / 接入说明 */\n  .clients{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}\n  .client{background:var(--panel);border:1px dashed var(--line);padding:22px}\n  .client h3{font-size:17px;margin-bottom:8px}\n  .client p{font-size:14px;color:var(--ink-soft)}\n  .client .meta{display:block;margin-top:12px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--mute)}\n\n  /* FAQ 折叠 */\n  .faq{display:grid;gap:10px;max-width:840px}\n  details{background:var(--panel);border:1px dashed var(--line);padding:0}\n  details[open]{border-color:var(--violet)}\n  summary{cursor:pointer;list-style:none;padding:16px 44px 16px 18px;font-weight:700;font-size:15px;position:relative}\n  summary::-webkit-details-marker{display:none}\n  summary::after{content:\"+\";position:absolute;right:18px;top:50%;transform:translateY(-50%);font-size:20px;font-weight:400;color:var(--violet);line-height:1}\n  details[open] summary::after{content:\"–\"}\n  details p{padding:0 44px 18px 18px;font-size:14px;color:var(--ink-soft);border-top:1px dashed var(--line);margin-top:0;padding-top:14px}\n\n  /* 结尾清单 */\n  .outro{border-top:1px dashed var(--line);padding-top:22px;font-size:14px;color:var(--mute);display:flex;flex-wrap:wrap;gap:8px 20px}\n\n  @media (max-width:820px){\n    .dash{grid-template-columns:repeat(2,1fr)}\n    .cell.wide{grid-column:span 2}\n    .clients{grid-template-columns:1fr}\n    .price{margin-left:0;text-align:left;width:100%}\n  }\n  @media (max-width:520px){\n    .dash{grid-template-columns:1fr}\n    .cell.wide{grid-column:span 1}\n    .step{grid-template-columns:44px 1fr;gap:12px}\n    .step::before{font-size:24px}\n    .plan{padding:20px}\n  }\n</style><main class=\"wrap\">\n\n  <header class=\"hero\">\n    <span class=\"hero-tag\">CrossWall / 页面清单</span>\n    <h1>柯洛斯(CrossWall) · 柯洛斯 <span>CrossWall</span>：把订阅、设备与疑问一次列清</h1>\n    <p class=\"hero-lead\">这是一份按条目组织的说明页。三档订阅各自多少钱、多少流量、几台设备，怎么选、怎么登记接入，常见疑问怎么答，都写在下面的格子里。</p>\n\n    <div class=\"dash\">\n      <div class=\"cell\">\n        <span class=\"k\">订阅档位</span>\n        <div class=\"v\">3 <small>档</small></div>\n        <p class=\"n\">基础版 / 旗舰版 / 团队版</p>\n      </div>\n      <div class=\"cell\">\n        <span class=\"k\">月付起价</span>\n        <div class=\"v\">¥15 <small>/ 月起</small></div>\n        <p class=\"n\">按年付可省下两个月量</p>\n      </div>\n      <div class=\"cell\">\n        <span class=\"k\">单档设备上限</span>\n        <div class=\"v\">3–20 <small>台</small></div>\n        <p class=\"n\">随档位递增</p>\n      </div>\n      <div class=\"cell mark\">\n        <span class=\"k\">推荐档位</span>\n        <div class=\"v\">旗舰版</div>\n        <p class=\"n\">¥35/月，多数个人用户落在这一档</p>\n      </div>\n      <div class=\"cell wide\">\n        <span class=\"k\">月度流量额度</span>\n        <div class=\"v\">100 / 300 / 1000 <small>GB</small></div>\n        <p class=\"n\">按档位区分，不跨月累计</p>\n      </div>\n      <div class=\"cell wide\">\n        <span class=\"k\">从哪里开始</span>\n        <div class=\"v\">先读方案，再看接入</div>\n        <p class=\"n\"><a href=\"#plans\">跳到订阅方案</a> 或 <a href=\"#faq\">直接看常见问题</a></p>\n      </div>\n    </div>\n\n    <nav class=\"jump\" aria-label=\"页面内跳转\">\n      <a href=\"#howto\">使用说明</a>\n      <a href=\"#plans\">订阅方案</a>\n      <a href=\"#clients\">接入与客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </header>\n\n  \n  <section id=\"howto\">\n    <p class=\"eyebrow\">01 / 使用说明</p>\n    <h2>四步走完，从看价到用上</h2>\n    <p class=\"section-lead\">下面的步骤只讲顺序和要准备的东西，不承诺任何具体线路或速度。每一步做完再进下一步，中间出问题就回头查上一条。</p>\n\n    <div class=\"steps\">\n      <div class=\"step\">\n        <div>\n          <h3>先算自己的量</h3>\n          <p>翻一遍最近一个月的上网记录，估出大概的流量和设备数量。设备数按“同一时间在线的台数”算，不是按注册过的设备总数算。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div>\n          <h3>对照档位选一条</h3>\n          <p>流量和设备都在基础版范围内，就选基础版；要同时在手机、平板、电脑上连着，看旗舰版；人多、机器多、需要按团队分配，看团队版。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div>\n          <h3>完成订阅并记录凭证</h3>\n          <p>订阅成功后，把订单编号、所选档位和生效日期记在自己能找得到的地方。后续任何沟通都以这几个字段为准，别只凭记忆。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div>\n          <h3>在设备上登记接入</h3>\n          <p>按所选客户端在每台设备上分别完成配置，然后确认设备数量没有超过档位上限。超出的设备先下线，再决定是否升档。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"plans\">\n    <p class=\"eyebrow\">02 / 订阅方案</p>\n    <h2>三档订阅，逐条列明</h2>\n    <p class=\"section-lead\">每一档都写清楚月付价、年付价、月度流量和同时在线设备数。年付金额就是下面写的数字，不再另加说明。</p>\n\n    <div class=\"plans\">\n\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>基础版</h3>\n          <div class=\"price\">\n            <b>¥15</b><span>每月</span>\n          </div>\n        </div>\n        <ul>\n          <li>每月 100GB 流量额度</li>\n          <li>同时在线 3 台设备</li>\n          <li>基础流媒体可用</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <p class=\"plan-note\">按年付 ¥150/年，相当于十个月的月付金额。适合一到两台设备、用量不大的日常使用者。</p>\n      </article>\n\n      <article class=\"plan top\">\n        <div class=\"plan-head\">\n          <h3>旗舰版</h3>\n          <span class=\"badge\">多数人选这档</span>\n          <div class=\"price\">\n            <b>¥35</b><span>每月</span>\n          </div>\n        </div>\n        <ul>\n          <li>每月 300GB 流量额度</li>\n          <li>同时在线 5 台设备</li>\n          <li>全节点可用，含流媒体相关节点</li>\n          <li>IPLC 专线，面向游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n        <p class=\"plan-note\">按年付 ¥350/年。手机、平板、办公电脑同时挂着也够用，是三档里覆盖场景最均衡的一档。</p>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>团队版</h3>\n          <div class=\"price\">\n            <b>¥85</b><span>每月</span>\n          </div>\n        </div>\n        <ul>\n          <li>每月 1000GB 流量额度</li>\n          <li>同时在线 20 台设备</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理对接</li>\n        </ul>\n        <p class=\"plan-note\">按年付 ¥850/年。适合一个小团队共用，或设备数量明显多于个人的场景；定制路由需要提前和客户经理确认能不能做。</p>\n      </article>\n\n    </div>\n  </section>\n\n  \n  <section id=\"clients\">\n    <p class=\"eyebrow\">03 / 接入与客户端</p>\n    <h2>按设备类型分别登记</h2>\n    <p class=\"section-lead\">下面按设备类别说明登记时的注意事项。具体客户端名称与下载地址以你订阅后收到的说明为准，本页不提供下载链接。</p>\n\n    <div class=\"clients\">\n      <article class=\"client\">\n        <h3>桌面电脑与笔记本</h3>\n        <p>在系统层面登记接入，一个系统账户算一台设备。同一台机器装了两套工具，只按一台计。</p>\n        <span class=\"meta\">计为 1 台</span>\n      </article>\n      <article class=\"client\">\n        <h3>手机与平板</h3>\n        <p>每台设备单独登记。手机和平板即使同账号，也各占一个设备名额。</p>\n        <span class=\"meta\">每台计 1 台</span>\n      </article>\n      <article class=\"client\">\n        <h3>路由器与家用网关</h3>\n        <p>在网关上统一接入时，按网关本身计为一台，不再按它下面挂的终端逐个计数。能否这样配置取决于设备型号。</p>\n        <span class=\"meta\">计为 1 台</span>\n      </article>\n      <article class=\"client\">\n        <h3>团队批量设备</h3>\n        <p>团队版按 20 台上限分配。建议先列出设备清单再统一登记，避免中途插队导致名额对不上。</p>\n        <span class=\"meta\">上限 20 台</span>\n      </article>\n    </div>\n  </section>\n\n  \n  <section id=\"faq\">\n    <p class=\"eyebrow\">04 / 常见问题</p>\n    <h2>常见问题，逐条折叠</h2>\n    <p class=\"section-lead\">点开任意一条看答案。这里的回答只涉及订阅规则与操作顺序，不涉及具体线路表现。</p>\n\n    <div class=\"faq\">\n\n      <details>\n        <summary>月付和年付，除了价格还差什么？</summary>\n        <p>只差计费周期。年付一次性付清一年的金额（基础版 ¥150、旗舰版 ¥350、团队版 ¥850），月付按每月金额结算。流量额度与设备上限按所选档位定，不因付款周期变化。</p>\n      </details>\n\n      <details>\n        <summary>流量当月没用完，能留到下个月吗？</summary>\n        <p>不能。额度按自然月计算，月末清零后重新发放，不累计、不结转。用量偏小的话，可以往下看一档，不必为了“留量”硬撑高档位。</p>\n      </details>\n\n      <details>\n        <summary>设备数量到底怎么算？</summary>\n        <p>按同一时间在线的设备台数算，不按注册过的历史设备总数算。下线一台就释放一个名额。基础版 3 台、旗舰版 5 台、团队版 20 台，是这个上限。</p>\n      </details>\n\n      <details>\n        <summary>中途从基础版升到旗舰版，怎么处理？</summary>\n        <p>先记录当前档位和生效日期，再提交升档，升档后设备上限与流量额度按新档位执行。本页不提供具体的折算比例，请以订阅时收到的说明为准，不要按本页内容自行推算金额。</p>\n      </details>\n\n      <details>\n        <summary>团队版的定制路由，谁都能配吗？</summary>\n        <p>不是。定制路由需要先和专属客户经理确认可行性与范围，确认之后才安排配置。没有确认前，请不要假设某一类路由一定能实现。</p>\n      </details>\n\n      <details>\n        <summary>三档都用同一个客户端吗？</summary>\n        <p>客户端类型由你的设备决定，不随档位变化。档位影响的是流量额度、同时在线设备数、可用节点范围和响应优先级。具体用哪个客户端，看订阅后收到的接入说明。</p>\n      </details>\n\n      <details>\n        <summary>为什么这页上找不到下载按钮？</summary>\n        <p>本页只做方案与规则的说明，不承载下载。所有安装与接入资料都随订阅一起给出，避免从这里跳到不规范的地方去拿文件。</p>\n      </details>\n\n      <details>\n        <summary>不确定该选哪一档，有没有简单的判断法？</summary>\n        <p>有。数一下你同时要用的设备台数：两三台、流量不大，基础版；五台上下、还要看流媒体或玩游戏，旗舰版；二十台以内、需要有人对接，团队版。拿不准就按设备数先定，再按流量微调。</p>\n      </details>\n\n    </div>\n\n    <p class=\"outro\">\n      <span>柯洛斯 CrossWall</span>\n      <span>本页内容为订阅规则与操作说明</span>\n      <span>价格以本页所列为准</span>\n    </p>\n  </section>\n\n</main>",
